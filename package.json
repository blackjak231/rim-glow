{
    "name": "rim-glow",
    "version": "0.1.0",
    "description": "Animated edge glow with a light wave, in CSS, as a framework-agnostic custom element.",
    "keywords": [
        "glow",
        "siri",
        "apple-intelligence",
        "border",
        "edge",
        "animation",
        "ripple",
        "mesh-gradient",
        "web-component",
        "custom-element",
        "css"
    ],
    "homepage": "https://github.com/blackjak231/rim-glow#readme",
    "bugs": {
        "url": "https://github.com/blackjak231/rim-glow/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/blackjak231/rim-glow.git"
    },
    "license": "SEE LICENSE IN LICENSE",
    "author": "blackjak231",
    "type": "module",
    "main": "./dist/rim-glow.js",
    "module": "./dist/rim-glow.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/rim-glow.js"
        },
        "./rim-glow.css": "./dist/rim-glow.css",
        "./iife": "./dist/rim-glow.iife.js"
    },
    "files": [
        "dist"
    ],
    "sideEffects": true,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "vite build --watch",
        "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit"
    },
    "release": {
        "branches": [
            "main"
        ]
    },
    "devDependencies": {
        "semantic-release": "^25.0.9",
        "typescript": "^7.0.0",
        "vite": "^8.3.0"
    }
}
